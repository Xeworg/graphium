{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Graphium",
  "version": "0.1.0",
  "identifier": "dev.graphium.plan",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Graphium",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'"
    }
  },
  "bundle": {
    "active": false
  }
}
